<resources>
    <!-- Base application theme -->
    <style name="Base.Theme.AppClimaRoque" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores principales -->
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryVariant">#64B5F6</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Puedes añadir más si quieres coherencia -->
        <item name="colorSecondary">#64B5F6</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:colorBackground">#FFFFFF</item>
    </style>

    <style name="Theme.AppClimaRoque" parent="Base.Theme.AppClimaRoque" />

    <!-- Estilo para tu BottomSheet -->
    <style name="FullScreenBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="behavior_peekHeight">0dp</item>
        <item name="behavior_hideable">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">#1976D2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SummaryCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
