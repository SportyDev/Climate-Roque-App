<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="150dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="TEMPERATURAS"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ambiente (°C)"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etTempAmbiente"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="°C"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Máxima (°C)"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etTempMaxima"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="°C"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mínima (°C)"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etTempMinima"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="°C"
                        android:inputType="numberDecimal|numberSigned"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="PRECIPITACIÓN"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cantidad (mm):"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCantidadLluvia"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="mm"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="EVAPORACIÓN"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lectura micrómeto:"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etLecturaMicrometro"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="mm"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Evaporación (mm):"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etEvaporacionMm"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="mm"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Evaporación 24 hrs:"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/etEvaporacion24hrs"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="mm"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">
            <CheckBox
                android:id="@+id/cbHelada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#1976D2"
                android:text="Helada"
                android:textColor="#000000"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>