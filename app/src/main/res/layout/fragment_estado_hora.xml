<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="150dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="ESTADO DEL TIEMPO A LA HORA DE OBSERVACIÓN"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Condición del cielo:"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbDespejadoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Despejado"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbMedioNubladoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="M. Nublado"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbNubladoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nublado"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:text="Temperatura:"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbFrioHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Frío"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbFrescoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fresco"
                        android:textColor="#000000"
                        android:textSize="12sp" />

                    <CheckBox
                        android:id="@+id/cbTempladoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Templado"
                        android:textColor="#000000"
                        android:textSize="11sp" />

                    <CheckBox
                        android:id="@+id/cbCalurosoHora"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Caluroso"
                        android:textColor="#000000"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dirección viento:"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etDireccionVientoHora"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="N, S, E, W"
                        android:inputType="textCapCharacters"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Intensidad:"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etIntensidadVientoHora"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="km/h"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbCalmaHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#1976D2"
                        android:text="Calma"
                        android:textColor="#000000" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Visibilidad:"
                        android:textColor="#000000"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etVisibilidadHora"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:background="@drawable/edittext_background"
                        android:gravity="center"
                        android:hint="km"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#9E9E9E" />

                </LinearLayout>
                

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Fenómenos diversos:"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etFenomenosHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_background"
                    android:gravity="top|start"
                    android:hint="Descripción de fenómenos observados..."
                    android:inputType="textMultiLine"
                    android:minHeight="100dp"
                    android:padding="12dp"
                    android:textColor="#000000"
                    android:textColorHint="#9E9E9E" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>